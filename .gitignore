# Raw datasets — do not upload
data/raw/

# Generated SQLite database (rebuild with: python -m src.database build)
data/processed/*.db
data/processed/*.db.building
*.sqlite3

# Python cache files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# Environment variables and secrets
.env
.env.*
!.env.example

# Frontend dependencies and build output (also in frontend/.gitignore)
node_modules/
frontend/dist/

# Test and coverage artifacts
.coverage
htmlcov/
.pytest_cache/

# Editor and operating system files
.vscode/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.log
